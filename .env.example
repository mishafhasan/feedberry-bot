# --- Required -----------------------------------------------------------------
# Bot token from @BotFather. Never commit .env.
BOT_TOKEN=
# Your numeric Telegram user id; operator alerts go here.
ADMIN_CHAT_ID=
# Self-hosted RSSHub (ADR-006). No public instances.
RSSHUB_BASE=http://rsshub:1200
# Optional: a self-hosted Bot API server. Leave empty for api.telegram.org.
# TELEGRAM_API_ROOT=http://127.0.0.1:8081
# Optional: a Telegra.ph access token for Instant View pages. Empty means the bot creates its own
# account once and stores the token next to the database (telegraph-token.txt).
TELEGRAPH_TOKEN=

# --- Storage ------------------------------------------------------------------
DB_PATH=data/bot.db

# --- Limits (ARCHITECTURE §6; defaults shown) ---------------------------------
MAX_SOURCES_PER_USER=250
MAX_CHATS_PER_USER=20
MAX_DOWNLOAD_MB=100
BACKFILL_COUNT=5
MAX_SOURCE_AGE_DAYS=30
WORKER_CONCURRENCY=2
MAX_DOWNLOADS_PER_DAY=300
# Abuse quotas (§12.4); 0 disables one.
CALLBACK_INTERVAL_MS=2000
ADD_INTERVAL_MS=10000
CHECKS_PER_HOUR=30

# --- Feature flags ------------------------------------------------------------
# Show the S1 trial line. OQ-7: off.
TRIAL_ENABLED=false
# Telegram channel sources (t.me/s scrape). OQ-3: off.
TELEGRAM_BETA=false
# RSSHub's X/Twitter route needs the `auth_token` cookie of a logged-in X account. With it, X profile
# sources are offered too; the bot also hands it to the media extractor, so login-gated X media
# downloads work. Without it, only public X posts download.
TWITTER_AUTH_TOKEN=
# RSSHub's Instagram route scrapes as a guest without this, and a datacenter IP is what Instagram
# throttles first. Only `sessionid` and `ds_user_id` are required: "sessionid=...; ds_user_id=...".
# Only the rsshub container gets it (ADR-006): docker-compose clears it from the bot's environment.
# INSTAGRAM_COOKIE=sessionid=....; ds_user_id=....
INSTAGRAM_COOKIE=
# RSSHub's Facebook route posts to facebook.com/api/graphql anonymously, and Facebook rate-limits
# that per IP: a cloud host answers "Rate limit exceeded" while a home connection does not. Log in
# to facebook.com, copy the whole Cookie request header, and paste it. Only the rsshub container
# gets it (ADR-006): docker-compose clears it from the bot's environment.
# FACEBOOK_COOKIE=c_user=......; xs=......; datr=......
FACEBOOK_COOKIE=
