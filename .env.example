# --- Required -----------------------------------------------------------------
# Bot token from @BotFather. Never commit .env.
BOT_TOKEN=
# Your numeric Telegram user id; operator alerts go here.
ADMIN_CHAT_ID=
# Self-hosted RSSHub. No public instances.
RSSHUB_BASE=http://rsshub:1200
# Optional: a self-hosted Bot API server. Leave empty for api.telegram.org.
# TELEGRAM_API_ROOT=http://127.0.0.1:8081
# Optional: a Telegra.ph access token for Instant View pages. Empty means the bot creates its own
# account once and stores the token next to the database (telegraph-token.txt).
TELEGRAPH_TOKEN=

# --- Storage ------------------------------------------------------------------
DB_PATH=data/bot.db

# --- Limits ---------------------------------
MAX_SOURCES_PER_USER=250
MAX_CHATS_PER_USER=20
MAX_DOWNLOAD_MB=100
BACKFILL_COUNT=5
MAX_SOURCE_AGE_DAYS=30
WORKER_CONCURRENCY=2
MAX_DOWNLOADS_PER_DAY=300
# Abuse quotas; 0 disables one.
CALLBACK_INTERVAL_MS=2000
ADD_INTERVAL_MS=10000
CHECKS_PER_HOUR=30

# --- Feature flags ------------------------------------------------------------
# Show the S1 trial line. OQ-7: off.
TRIAL_ENABLED=false
# Telegram channel sources (t.me/s scrape). OQ-3: off.
TELEGRAM_BETA=false
# RSSHub's X/Twitter route needs the `auth_token` cookie of a logged-in X account. With it, X profile
# sources are offered too; the bot also hands it to the media extractor, so login-gated X media
# downloads work. Without it, only public X posts download.
TWITTER_AUTH_TOKEN=
# RSSHub's Instagram route scrapes as a guest without this, and a datacenter IP is what Instagram
# throttles first. Only `sessionid` and `ds_user_id` are required: "sessionid=...; ds_user_id=...".
# Only the rsshub container gets it: docker-compose clears it from the bot's environment.
# INSTAGRAM_COOKIE=sessionid=....; ds_user_id=....
INSTAGRAM_COOKIE=
# RSSHub's Facebook route posts to facebook.com/api/graphql anonymously, and Facebook rate-limits
# that per IP: a cloud host answers "Rate limit exceeded" while a home connection does not. Log in
# to facebook.com, copy the whole Cookie request header, and paste it. Only the rsshub container
# gets it: docker-compose clears it from the bot's environment.
# FACEBOOK_COOKIE=c_user=......; xs=......; datr=......
FACEBOOK_COOKIE=

# --- Daily digest ---------------------------------------------------
# One Google AI Studio key powers both the summaries and the speech. Empty turns the whole feature
# off: no menu button, no digest jobs.
GEMINI_API_KEY=
# Model ids rotate, so both are config. Defaults: gemini-3.8-flash / gemini-3.8-flash-tts.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Quotas and capacity are per model on the free tier, so each role walks a ladder on 429/5xx.
# Default text tail: gemini-3.6-flash,gemini-4-hydrogen,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-3.5-flash-lite
# Default voice tail: gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
# GEMINI_TEXT_FALLBACKS=gemini-3.6-flash,gemini-4-hydrogen,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-3.5-flash-lite
# GEMINI_TTS_FALLBACKS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
# Cost guard: posts beyond this many are listed as headline links instead of being summarised.
DIGEST_MAX_POSTS=20
