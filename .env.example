# --- Required -----------------------------------------------------------------
# Bot token from @BotFather. Never commit .env.
BOT_TOKEN=
# Your numeric Telegram user id; operator alerts go here.
ADMIN_CHAT_ID=
# Self-hosted RSSHub (ADR-006). No public instances.
RSSHUB_BASE=http://rsshub:1200
# Optional: a self-hosted Bot API server. Leave empty for api.telegram.org.
# TELEGRAM_API_ROOT=http://127.0.0.1:8081
# Optional: a Telegra.ph access token for Instant View pages. Empty means the bot creates its own
# account once and stores the token next to the database (telegraph-token.txt).
TELEGRAPH_TOKEN=

# --- Storage ------------------------------------------------------------------
DB_PATH=data/bot.db

# --- Limits (ARCHITECTURE §6; defaults shown) ---------------------------------
MAX_SOURCES_PER_USER=250
MAX_CHATS_PER_USER=20
MAX_DOWNLOAD_MB=100
BACKFILL_COUNT=5
MAX_SOURCE_AGE_DAYS=30
WORKER_CONCURRENCY=2
MAX_DOWNLOADS_PER_DAY=30
# Abuse quotas (§12.4); 0 disables one.
CALLBACK_INTERVAL_MS=2000
ADD_INTERVAL_MS=10000
CHECKS_PER_HOUR=30

# --- Feature flags ------------------------------------------------------------
# Show the S1 trial line. OQ-7: off.
TRIAL_ENABLED=false
# Telegram channel sources (t.me/s scrape). OQ-3: off.
TELEGRAM_BETA=false
